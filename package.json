{
  "name": "@podlove/web-player-configurator",
  "version": "5.10.0",
  "description": "Podlove Web Player Configurator",
  "author": "Alexander Heimbuch <github@heimbu.ch>",
  "scripts": {
    "dist:clean": "rm -rf dist/*",
    "plugin:copy": "mkdir -p dist/ && cp -R src/plugin/* dist/ && cp -R node_modules/@podlove/web-player dist/",
    "plugin:dev": "nodemon --ext php --watch src/plugin --exec 'npm run plugin:copy'",
    "plugin:env": "cp ./env/.htaccess ./wp/.htaccess && cp ./env/wp-config.php ./wp/wp-config.php && mkdir -p ./wp/wp-content/mu-plugins && cp ./env/mu-plugins/* ./wp/wp-content/mu-plugins/*",
    "js:dev": "NODE_OPTIONS=--openssl-legacy-provider webpack --watch --config build/webpack.dev.conf.js",
    "js:build": "NODE_OPTIONS=--openssl-legacy-provider webpack --config build/webpack.prod.conf.js",
    "dev": "npm run dist:clean && concurrently 'npm run plugin:dev' 'npm run js:dev' 'npm run css:dev'",
    "build": "npm run dist:clean && npm run plugin:copy && npm run js:build && npm run css:build",
    "package": "npm run build && cd dist && zip -r -X podlove-web-player-beta.zip .",
    "publish:prepare": "npm run build && cp -R ./src/assets ./dist/.wordpress-org && cp -R .git dist/ && cp .distignore dist/",
    "publish:workspace": "node build/workspace.js",
    "version": "node ./build/version.js",
    "release": "release-it",
    "css:build": "sass --no-source-map src/block/block.scss dist/block/css/block.css",
    "css:dev": "sass --watch --no-source-map src/block/block.scss:dist/block/css/block.css",
    "test:block": "node --test tests/block/*.test.js"
  },
  "dependencies": {
    "@podlove/clients": "5.12.0",
    "@podlove/player-actions": "5.12.2",
    "@podlove/web-player": "5.13.0",
    "element-ui": "^2.15.14",
    "jquery": "^4.0.0",
    "lodash": "^4.18.1",
    "normalize.css": "8.0.1",
    "object-hash": "3.0.0",
    "prismjs": "1.30.0",
    "shortid": "2.2.17",
    "tailwindcss": "1.9.6",
    "vue": "2.7.16",
    "vue-prism-editor": "0.6.1",
    "vue-resource": "^1.5.3",
    "vue-router": "3.6.5",
    "vuedraggable": "^2.24.3",
    "vuex": "3.6.2",
    "vuex-router-sync": "5.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-regenerator": "7.29.8",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "^7.29.7",
    "autoprefixer": "9.8.8",
    "babel-loader": "8.4.1",
    "babel-plugin-lodash": "3.3.4",
    "concurrently": "^9.2.4",
    "connect-history-api-fallback": "2.0.0",
    "copy": "0.3.2",
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "5.2.7",
    "cssnano": "4.1.11",
    "eventsource-polyfill": "0.9.6",
    "expose-loader": "1.0.3",
    "express": "4.22.3",
    "file-loader": "6.2.0",
    "friendly-errors-webpack-plugin": "1.7.0",
    "fs-extra": "^11.4.0",
    "html-webpack-plugin": "4.5.2",
    "http-proxy-middleware": "3.0.7",
    "json-server": "0.17.4",
    "nodemon": "^3.1.14",
    "opn": "6.0.0",
    "optimize-css-assets-webpack-plugin": "6.0.1",
    "ora": "^9.4.1",
    "postcss-clean": "^1.2.2",
    "postcss-loader": "3.0.0",
    "release-it": "^19.2.4",
    "replace-in-file": "^7.2.0",
    "rimraf": "^6.1.3",
    "sass": "1.99.0",
    "sass-loader": "10.5.2",
    "semver": "^7.8.5",
    "shelljs": "^0.10.0",
    "url-loader": "4.1.1",
    "vue-loader": "15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "2.7.16",
    "webpack": "4.47.0",
    "webpack-bundle-analyzer": "^5.3.3",
    "webpack-cli": "3.3.12",
    "webpack-dev-middleware": "5.3.4",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-merge": "4.2.2"
  },
  "engines": {
    "node": "^20.18.1 || >=22.9.0",
    "npm": ">=11.18.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "release-it": {
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "after:bump": "npm run version"
    }
  },
  "overrides": {
    "release-it": {
      "c12": "3.3.2"
    },
    "@octokit/request": "10.0.14"
  }
}
